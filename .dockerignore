**/.terraform
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
.terraformrc
terraform.rc

# Build / test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
__debug_bin*
crash.log
crash.*.log
bin/

# Python venv / cache (left behind by plugin development)
.venv
__pycache__
*.pyc
